{
  "name": "@gtd/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "gtd": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun run dist/index.js",
    "build:binary": "bun build ./src/index.tsx --compile --outfile ../gtd",
    "test": "bun test src/__tests__/"
  },
  "dependencies": {
    "@gtd/core": "workspace:*",
    "ink": "^7.0.0",
    "react": "^19.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  }
}